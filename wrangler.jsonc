{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cs-higherlower",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs-higherlower",
      "database_id": "f1ed626e-04db-46c9-9279-5ddf3dfeeb99",
      "migrations_dir": "drizzle"
    },
    {
      "binding": "cs_higherlower",
      "database_name": "cs-higherlower",
      "database_id": "f1ed626e-04db-46c9-9279-5ddf3dfeeb99"
    }
  ],
  "vars": {
    "DEFAULT_TIMEZONE": "Europe/Brussels",
    "PRICE_SYNC_BATCH_SIZE": "8",
    "PRICE_SYNC_DELAY_MS": "1200"
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
